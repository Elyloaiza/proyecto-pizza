# Copie este archivo a .env.local (local) y configure las MISMAS variables en
# Vercel: Project → Settings → Environment Variables. No suba claves al repositorio.
# Nunca use el prefijo VITE_ ni NEXT_PUBLIC_ con la clave: quedaría expuesta al navegador.

OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/inference/openai/v1
# ID real del modelo disponible para su cuenta, SIN prefijo de proveedor
# (verifíquelo con: GET https://opencode.ai/inference/v1/models). Ejemplo de la documentación: claude-sonnet-5-5
OPENCODE_MODEL=
AI_ENABLED=true

# Opcionales
# OPENCODE_MAX_OUTPUT_TOKENS=1500
# OPENCODE_TOKEN_PARAM=max_tokens   # o max_completion_tokens si el modelo lo exige
